APP_NAME=Phoenix AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# LLM provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Default models
OPENAI_MODEL=gpt-5.6
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-2.5-pro

# Routing
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-5.6
TEMPERATURE=0.2
MAX_TOKENS=4096

# Security
REQUIRE_APPROVAL_FOR_TOOLS=true
MAX_TOOL_CALLS_PER_TASK=20

# Future infrastructure
DATABASE_URL=postgresql+psycopg://phoenix:phoenix@localhost:5432/phoenix
REDIS_URL=redis://localhost:6379/0
